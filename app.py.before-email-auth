@app.route("/api/users", methods=["POST"])
def create_user():
    data = request.get_json() or {}
    line_user_id = data.get("line_user_id")
    display_name = data.get("display_name")
    picture_url = data.get("picture_url")
    bnpl_limit = data.get("bnpl_limit")

    if not line_user_id:
        return jsonify({"error": "line_user_id is required"}), 400

    existing_user = User.query.filter_by(line_user_id=line_user_id).first()
    if existing_user:
        if display_name and existing_user.display_name != display_name:
            existing_user.display_name = display_name
        if picture_url:
            existing_user.picture_url = picture_url
        if bnpl_limit not in (None, ""):
            existing_user.bnpl_limit = float(bnpl_limit)
        if existing_user.bnpl_limit is None:
            existing_user.bnpl_limit = 40000
        db.session.commit()
        return jsonify({"user": existing_user.to_dict(), "created": False}), 200

    user = User(
        line_user_id=line_user_id,
        display_name=display_name,
        picture_url=picture_url,
        bnpl_limit=float(bnpl_limit) if bnpl_limit not in (None, "") else 40000,
    )
    db.session.add(user)
    db.session.commit()

    return jsonify({"user": user.to_dict(), "created": True}), 201


def get_user_or_404(line_user_id):
    user = User.query.filter_by(line_user_id=line_user_id).first()
    if not user:
        return None, (jsonify({"error": "user not found"}), 404)
    return user, None


def bnpl_alert_payload(item):
    today = date.today()
    days_left = (item.due_date - today).days
    installments_left = max(item.installments_total - item.installments_paid, 0)
    remaining_amount = installments_left * item.installment_amount

    if installments_left <= 0:
        status = "paid"
        message = f"{item.item_name} จ่ายครบแล้ว"
    elif days_left < 0:
        status = "overdue"
        message = (
            f"แจ้งเตือน Moniba: {item.item_name} เลยกำหนด {abs(days_left)} วัน "
            f"ยอดงวดนี้ {item.installment_amount:,.0f} บาท"
        )
    elif days_left <= 3:
        status = "due_soon"
        message = (
            f"แจ้งเตือน Moniba: {item.item_name} ครบกำหนดใน {days_left} วัน "
            f"ยอดงวดนี้ {item.installment_amount:,.0f} บาท"
        )
    else:
        status = "upcoming"
        message = (
            f"{item.item_name} ครบกำหนดวันที่ {item.due_date.isoformat()} "
            f"ยอดงวดนี้ {item.installment_amount:,.0f} บาท"
        )

    payload = item.to_dict()
    payload.update({
        "days_left": days_left,
        "installments_left": installments_left,
        "remaining_amount": remaining_amount,
        "alert_status": status,
        "alert_message": message,
    })
    return payload


def push_line_message(line_user_id, text):
    token = app.config.get("LINE_CHANNEL_ACCESS_TOKEN")
    if not token:
        return {"sent": False, "error": "LINE_CHANNEL_ACCESS_TOKEN is not configured"}, 400

    body = json.dumps({
        "to": line_user_id,
        "messages": [{"type": "text", "text": text}],
    }).encode("utf-8")

    line_request = Request(
        app.config["LINE_PUSH_API_URL"],
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}",
        },
    )

    try:
        with urlopen(line_request, timeout=10) as response:
            return {"sent": True, "status_code": response.status}, response.status
    except HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")
        return {"sent": False, "status_code": error.code, "error": detail}, error.code
    except URLError as error:
        return {"sent": False, "error": str(error.reason)}, 502


