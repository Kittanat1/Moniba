@app.route("/api/alerts/bnpl", methods=["GET"])
def get_bnpl_alerts():
    line_user_id = request.args.get("line_user_id")
    user, error = get_user_or_404(line_user_id)
    if error:
        return error

    alert_days = int(request.args.get("days", 3))
    items = BNPLItem.query.filter_by(user_id=user.id).all()
    alerts = [
        bnpl_alert_payload(item)
        for item in items
        if item.installments_paid < item.installments_total
        and (item.due_date - date.today()).days <= alert_days
    ]

    return jsonify({"alerts": alerts})


@app.route("/api/line/push-alerts", methods=["POST"])
def push_bnpl_alerts_to_line():
    data = request.get_json() or {}
    line_user_id = data.get("line_user_id")
    user, error = get_user_or_404(line_user_id)
    if error:
        return error

    alert_days = int(data.get("days", 3))
    items = BNPLItem.query.filter_by(user_id=user.id).all()
    messages = [
        bnpl_alert_payload(item)["alert_message"]
        for item in items
        if item.installments_paid < item.installments_total
        and (item.due_date - date.today()).days <= alert_days
    ]

    if not messages:
        return jsonify({"sent": False, "message": "no alerts to send", "alerts": []}), 200

    result, status_code = push_line_message(line_user_id, "\n\n".join(messages[:5]))
    return jsonify({**result, "alerts": messages}), status_code

