def verify_line_id_token(id_token):
    channel_id = app.config.get("LINE_LOGIN_CHANNEL_ID")
    if not channel_id:
        return None, (jsonify({
            "error": "LINE_LOGIN_CHANNEL_ID is not configured"
        }), 500)

    body = json.dumps({
        "id_token": id_token,
        "client_id": channel_id,
    }).encode("utf-8")

    verify_request = Request(
        app.config["LINE_ID_TOKEN_VERIFY_URL"],
        data=body,
        method="POST",
        headers={"Content-Type": "application/json"},
    )

    try:
        with urlopen(verify_request, timeout=10) as response:
            return json.loads(response.read().decode("utf-8")), None
    except (HTTPError, URLError, json.JSONDecodeError) as error:
        return None, (jsonify({
            "error": "LINE ID token verification failed",
            "detail": str(error),
        }), 401)



@app.route("/api/auth/register", methods=["POST"])
def register_manual_account():
    data = request.get_json() or {}
    username = (data.get("username") or "").strip().lower()
    display_name = (data.get("display_name") or data.get("username") or "").strip()
    password = data.get("password") or ""
    bnpl_limit = data.get("bnpl_limit")

    if not username or not password:
        return jsonify({"error": "username and password are required"}), 400
    if len(username) < 3:
        return jsonify({"error": "username must be at least 3 characters"}), 400
    if len(password) < 6:
        return jsonify({"error": "password must be at least 6 characters"}), 400

    existing_user = User.query.filter_by(username=username).first()
    if existing_user:
        return jsonify({"error": "username already exists"}), 409

    user = User(
        line_user_id=f"manual:{username}",
        username=username,
        password_hash=generate_password_hash(password),
        display_name=display_name or username,
        bnpl_limit=float(bnpl_limit) if bnpl_limit not in (None, "") else 40000,
    )
    db.session.add(user)
    db.session.commit()

    return jsonify({"user": user.to_dict(), "created": True}), 201


@app.route("/api/auth/login", methods=["POST"])
def login_manual_account():
    data = request.get_json() or {}
    username = (data.get("username") or "").strip().lower()
    password = data.get("password") or ""

    if not username or not password:
        return jsonify({"error": "username and password are required"}), 400

    user = User.query.filter_by(username=username).first()
    if not user or not user.password_hash or not check_password_hash(user.password_hash, password):
        return jsonify({"error": "username or password is incorrect"}), 401

    return jsonify({"user": user.to_dict(), "created": False}), 200
@app.route("/api/line/connect", methods=["POST"])
def connect_line_account():
    data = request.get_json() or {}
    id_token = data.get("id_token")

    if not id_token:
        return jsonify({"error": "id_token is required"}), 400

    claims, error = verify_line_id_token(id_token)
    if error:
        return error

    line_user_id = claims.get("sub")
    if not line_user_id:
        return jsonify({"error": "LINE did not return a user ID"}), 401

    user = User.query.filter_by(line_user_id=line_user_id).first()
    created = user is None

    if created:
        user = User(line_user_id=line_user_id, bnpl_limit=40000)
        db.session.add(user)

    user.display_name = claims.get("name") or user.display_name
    user.picture_url = claims.get("picture") or user.picture_url
    db.session.commit()

    return jsonify({"user": user.to_dict(), "created": created})

