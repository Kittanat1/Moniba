@app.route("/api/transactions", methods=["GET"])
def get_transactions():
    line_user_id = request.args.get("line_user_id")
    month = request.args.get("month")       # เช่น "2026-07"
    category = request.args.get("category") # เช่น "อาหาร"

    user, error = get_user_or_404(line_user_id)
    if error:
        return error

    query = Transaction.query.filter_by(user_id=user.id)

    if month:
        year, month_num = month.split("-")
        query = query.filter(
            extract("year", Transaction.date) == int(year),
            extract("month", Transaction.date) == int(month_num),
        )

    if category:
        query = query.filter(Transaction.category == category)

    items = query.order_by(Transaction.date.desc()).all()

    total_income = sum(t.amount for t in items if t.type == "income")
    total_expense = sum(t.amount for t in items if t.type == "expense")

    return jsonify({
        "items": [t.to_dict() for t in items],
        "summary": {
            "total_income": total_income,
            "total_expense": total_expense,
            "balance": total_income - total_expense,
        }
    })

@app.route("/api/transactions/summary-by-category", methods=["GET"])
def summary_by_category():
    line_user_id = request.args.get("line_user_id")
    month = request.args.get("month")

    user, error = get_user_or_404(line_user_id)
    if error:
        return error

    query = db.session.query(
        Transaction.category,
        func.sum(Transaction.amount).label("total")
    ).filter(
        Transaction.user_id == user.id,
        Transaction.type == "expense",
    )

    if month:
        year, month_num = month.split("-")
        query = query.filter(
            extract("year", Transaction.date) == int(year),
            extract("month", Transaction.date) == int(month_num),
        )

    results = query.group_by(Transaction.category).all()

    return jsonify({
        "categories": [r.category or "ไม่ระบุหมวดหมู่" for r in results],
        "totals": [r.total for r in results],
    })


